#!/usr/bin/env bash
# Attaches the web terminal to the chat session, as the antigravity user.
LIB=/usr/local/lib/ha-antigravity
for f in paths log options env retention session; do
  # shellcheck disable=SC1090
  . "$LIB/$f.sh"
done
if ! chat_alive; then
  export HC_LOG=/proc/1/fd/2
  log "web terminal: no chat session, starting one"
  start_chat
  unset HC_LOG
fi
as_antigravity tmux -L "$HC_TMUX_SOCKET" attach -t "$HC_TMUX_SESSION"

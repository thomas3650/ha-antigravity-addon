#!/usr/bin/env bash
# The loop inside the tmux chat session. Runs as the antigravity user.
LIB=/usr/local/lib/ha-antigravity
for f in paths log options env retention session; do
  # shellcheck disable=SC1090
  . "$LIB/$f.sh"
done

cd "$HC_WORKSPACE" || exit 1
quick_exits=0

while true; do
  if ! logged_in; then
    cat <<'EOT'

  Antigravity CLI is not logged in.

  1. Run:  agy
  2. Open the Google login URL shown in your browser, sign in, and paste
     the authorization code back into this terminal.
  3. Exit agy (/exit), then run:  exit
     The add-on starts the chat session within a minute.

EOT
    exec bash -l
  fi
  next_chat_argv
  clean_handover
  started=$SECONDS
  "${CHAT_ARGV[@]}"
  rc=$?
  if chat_resume_failed "$((SECONDS - started))" "$rc"; then
    echo "Antigravity CLI could not continue the last conversation (code $rc). Starting a new one."
    continue
  fi
  quick_exits="$(chat_quick_exits "$quick_exits" "$((SECONDS - started))")"
  [[ "$quick_exits" =~ ^[0-9]+$ ]] || quick_exits=3
  if (( quick_exits >= 3 )); then
    echo "Antigravity CLI exited three times within 30 seconds (last code $rc)."
    echo "Leaving a shell here. Type 'exit' to let the add-on try again."
    exec bash -l
  fi
  echo "Antigravity CLI exited with code $rc. Starting again in 10 seconds."
  sleep 10
done
